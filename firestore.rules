rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /** Match admin / Admin / ADMIN (console copy-paste). RE2 case-insensitive flag. */
    function isAdminUserType(t) {
      return t is string && t.matches('(?i)^admin$');
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && isAdminUserType(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType);
    }

    function userProfileEmailMatchesAuthToken() {
      return request.auth.token.email == null
        || request.resource.data.email == request.auth.token.email;
    }

    function blogPostPublished(postId) {
      return exists(/databases/$(database)/documents/blog_posts/$(postId))
        && get(/databases/$(database)/documents/blog_posts/$(postId)).data.published == true;
    }

    function commentReplyParentValid(postId, parentId) {
      return parentId == null
        || (
          exists(/databases/$(database)/documents/blog_posts/$(postId)/comments/$(parentId))
          && get(/databases/$(database)/documents/blog_posts/$(postId)/comments/$(parentId)).data.parentCommentId == null
        );
    }

    function catalogWholeNaira(n) {
      return n is number && n == int(n) && int(n) >= 0 && int(n) <= 100000000;
    }

    function catalogStyleVariantItem(v) {
      return v is map
        && v.keys().hasAll(['id', 'label', 'price'])
        && v.keys().size() <= 5
        && v.id is string
        && v.id.size() > 0
        && v.id.size() <= 40
        && v.label is string
        && v.label.size() > 0
        && v.label.size() <= 120
        && catalogWholeNaira(v.price)
        && (!('compareAtPrice' in v)
          || (catalogWholeNaira(v.compareAtPrice) && int(v.compareAtPrice) > int(v.price)))
        && (!('image' in v)
          || (v.image is string
            && v.image.size() > 10
            && v.image.size() <= 8192
            && v.image.matches('^https://.+')));
    }

    function catalogStyleVariantsValid(list) {
      return list is list
        && list.size() >= 1
        && list.size() <= 6
        && catalogStyleVariantItem(list[0])
        && (list.size() < 2 || catalogStyleVariantItem(list[1]))
        && (list.size() < 3 || catalogStyleVariantItem(list[2]))
        && (list.size() < 4 || catalogStyleVariantItem(list[3]))
        && (list.size() < 5 || catalogStyleVariantItem(list[4]))
        && (list.size() < 6 || catalogStyleVariantItem(list[5]));
    }

    function catalogStyleIdString(s) {
      return s is string && s.size() > 0 && s.size() <= 40;
    }

    function catalogGalleryStyleLinkItem(link) {
      return link.keys().hasAll(['image', 'styleIds'])
        && link.keys().size() == 2
        && link.image is string
        && link.image.size() > 10
        && link.image.size() <= 8192
        && link.image.matches('^https://.+')
        && link.styleIds is list
        && link.styleIds.size() >= 1
        && link.styleIds.size() <= 6
        && catalogStyleIdString(link.styleIds[0])
        && (link.styleIds.size() < 2 || catalogStyleIdString(link.styleIds[1]))
        && (link.styleIds.size() < 3 || catalogStyleIdString(link.styleIds[2]))
        && (link.styleIds.size() < 4 || catalogStyleIdString(link.styleIds[3]))
        && (link.styleIds.size() < 5 || catalogStyleIdString(link.styleIds[4]))
        && (link.styleIds.size() < 6 || catalogStyleIdString(link.styleIds[5]));
    }

    function catalogGalleryStyleLinksValid(list) {
      return list is list
        && list.size() >= 1
        && list.size() <= 6
        && catalogGalleryStyleLinkItem(list[0])
        && (list.size() < 2 || catalogGalleryStyleLinkItem(list[1]))
        && (list.size() < 3 || catalogGalleryStyleLinkItem(list[2]))
        && (list.size() < 4 || catalogGalleryStyleLinkItem(list[3]))
        && (list.size() < 5 || catalogGalleryStyleLinkItem(list[4]))
        && (list.size() < 6 || catalogGalleryStyleLinkItem(list[5]));
    }

    function catalogProductCore(catalogSlug) {
      let d = request.resource.data;
      return d.slug is string
        && d.slug == catalogSlug
        && d.slug.size() > 1
        && d.slug.size() < 120
        && d.name is string
        && d.name.size() > 0
        && d.name.size() < 200
        && d.tag is string
        && d.tag.size() > 0
        && d.tag.size() < 120
        && catalogWholeNaira(d.price)
        && (!('compareAtPrice' in d)
          || (catalogWholeNaira(d.compareAtPrice)
            && int(d.compareAtPrice) > int(d.price)))
        && d.lead is string
        && d.lead.size() > 0
        && d.lead.size() <= 4000
        && d.description is string
        && d.description.size() > 0
        && d.description.size() <= 20000
        && d.image is string
        && d.image.size() > 10
        && d.image.size() <= 8192
        // matches() is full-string: ^https:// alone rejects any URL longer than the scheme.
        && d.image.matches('^https://.+')
        && (!('sourceImage' in d)
          || (d.sourceImage is string
            && d.sourceImage.size() > 10
            && d.sourceImage.size() <= 8192
            && d.sourceImage.matches('^https://.+')))
        && (!('galleryImageUrls' in d)
          || (d.galleryImageUrls is list && d.galleryImageUrls.size() <= 6))
        && (!('fittingNotes' in d) || (d.fittingNotes is string && d.fittingNotes.size() <= 4000))
        && (!('fabricCareNotes' in d) || (d.fabricCareNotes is string && d.fabricCareNotes.size() <= 4000))
        && (!('shippingNotes' in d) || (d.shippingNotes is string && d.shippingNotes.size() <= 4000))
        && (!('craftFabricNotes' in d) || (d.craftFabricNotes is string && d.craftFabricNotes.size() <= 4000))
        && (!('colourAvailabilityNotes' in d)
          || (d.colourAvailabilityNotes is string && d.colourAvailabilityNotes.size() <= 4000))
        && (!('craftFabricLabels' in d)
          || (d.craftFabricLabels is list && d.craftFabricLabels.size() <= 8))
        && (!('styleVariants' in d) || catalogStyleVariantsValid(d.styleVariants))
        && (!('galleryStyleLinks' in d) || catalogGalleryStyleLinksValid(d.galleryStyleLinks));
    }

    match /catalog_products/{slug} {
      allow read: if true;
      allow create: if isAdmin() && catalogProductCore(slug);
      allow update: if isAdmin()
        && catalogProductCore(slug)
        && request.resource.data.slug == resource.data.slug;
      allow delete: if isAdmin();
    }

    function siteFeaturedSchema() {
      let d = request.resource.data;
      return d.collectionTilePins is map
        && d.lookbookPins is map
        && d.collectionTilePins.size() <= 20
        && d.lookbookPins.size() <= 20;
    }

    match /site_featured/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && siteFeaturedSchema();
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'submitted';
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin() && request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.userType == 'user'
        && userProfileEmailMatchesAuthToken();

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.userType == resource.data.userType
        && userProfileEmailMatchesAuthToken();

      allow delete: if false;
    }

    match /blog_posts/{postId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /blog_posts/{postId}/likes/{likeUid} {
      allow read: if blogPostPublished(postId);
      allow create: if request.auth != null
        && request.auth.uid == likeUid
        && blogPostPublished(postId)
        && request.resource.data.keys().hasOnly(['createdAt']);
      allow delete: if request.auth != null && request.auth.uid == likeUid;
      allow update: if false;
    }

    match /blog_posts/{postId}/comments/{commentId} {
      allow read: if blogPostPublished(postId);
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorDisplayName is string
        && request.resource.data.authorDisplayName.size() > 0
        && request.resource.data.authorDisplayName.size() < 200
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() < 8000
        && (request.resource.data.parentCommentId == null
          || (request.resource.data.parentCommentId is string
            && request.resource.data.parentCommentId.size() > 0))
        && blogPostPublished(postId)
        && commentReplyParentValid(postId, request.resource.data.parentCommentId);
      allow update: if request.auth != null
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.parentCommentId == resource.data.parentCommentId
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() < 8000
        && blogPostPublished(postId);
      allow delete: if request.auth != null
        && (resource.data.authorUid == request.auth.uid || isAdmin());
    }
  }
}
