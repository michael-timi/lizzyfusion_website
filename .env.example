# Public site URL (no trailing slash). Required for correct Open Graph URLs, sitemap, and robots in production.
# Example: https://www.lizzyfusion.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase — Auth, Firestore, Storage, Analytics (web app config).
# Firebase Console → Project settings → Your apps → Web app (SDK snippet).
# Enable Authentication → Sign-in method → Google + Email/Password.
# Add authorized domains: localhost (dev) and your production host.
#
# Firestore: create default database in console → deploy rules: firebase deploy --only firestore:rules
# Storage: enable Storage → deploy rules: firebase deploy --only storage
# Analytics: enable/link GA4 in console; copy measurementId into NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID
#
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lizzy-fusion.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=lizzy-fusion
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=lizzy-fusion.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
#
# App Hosting injects this JSON at build (local dev usually uses NEXT_PUBLIC_* above instead):
# FIREBASE_WEBAPP_CONFIG=
