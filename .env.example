# Public site URL (no trailing slash). Required for correct Open Graph URLs, sitemap, and robots in production.
# Example: https://www.lizzyfusion.com
# App Hosting: set the same variable on the backend in Firebase console; see README.md → "Firebase App Hosting (pre-deploy)".
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser console: log every `fetch` + window errors (also on in `next dev` without this).
# NEXT_PUBLIC_LOG_NETWORK=1
# Server/Edge terminal: log each incoming request (middleware). Omit in production unless debugging.
# LOG_INCOMING_REQUESTS=1

# Firebase — Auth, Firestore, Storage, Analytics (web app config).
# Firebase Console → Project settings → Your apps → Web app (SDK snippet).
# Enable Authentication → Sign-in method → Google + Email/Password.
# Add authorized domains: localhost (dev) and your production host.
#
# Firestore: create default database in console → deploy rules: firebase deploy --only firestore:rules
# Admin dashboard (/admin): promote a user in Firestore `users/{uid}` → field `userType` = `admin` (console or Admin SDK).
# Storage: enable Storage → deploy rules: firebase deploy --only storage
# Analytics (GA4 via Firebase): enable/link GA4 in console; copy measurementId into NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID.
# Events are logged client-side from src/lib/analytics-events.ts (page views, cart, checkout, auth, WhatsApp, etc.).
#
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lizzy-fusion.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=lizzy-fusion
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=lizzy-fusion.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
#
# App Hosting injects this JSON at build (local dev usually uses NEXT_PUBLIC_* above instead):
# FIREBASE_WEBAPP_CONFIG=

# --- Server-only: catalogue hero (Gemini) + admin token verify ---
# GEMINI_API_KEY=                    # https://aistudio.google.com/apikey
# Use ONE of the following (same service account JSON Firebase offers for Admin SDK).
# Prefer a file path — avoids .env escaping issues (use your real path; not the placeholder below):
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/your-project-firebase-adminsdk-xxxxx.json
# (Alternative) GOOGLE_APPLICATION_CREDENTIALS=/same/path/serviceAccount.json
#
# If both PATH and FIREBASE_SERVICE_ACCOUNT_JSON are set, an existing file at PATH wins.
# Remove FIREBASE_SERVICE_ACCOUNT_JSON entirely when using only the file path.
#
# Inline JSON must be ONE line, start with { (no character before it). Do not paste the path string here.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}
