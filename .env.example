# Public site URL (no trailing slash). Required for correct Open Graph URLs, sitemap, and robots in production.
# Example: https://www.lizzyfusion.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase — required for Auth (checkout) and optional elsewhere.
# Firebase Console → Project settings → Your apps → Web app.
# Enable Authentication → Sign-in method → Google (and Email/Password for email register/login).
# Add authorized domains: localhost (dev) and your production host.
#
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lizzy-fusion.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=lizzy-fusion
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=lizzy-fusion.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional Analytics
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
#
# App Hosting injects this JSON at build (local dev usually uses NEXT_PUBLIC_* above instead):
# FIREBASE_WEBAPP_CONFIG=
#
# Firestore (orders from checkout): enable Firestore in the console, then deploy rules:
#   firebase deploy --only firestore:rules
